# =============================================================================
# GLAI Website — environment variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# =============================================================================

# PostgreSQL (Supabase). URL-encode special characters in the password
# (e.g. $ → %24). Direct connection uses port 5432; add ?sslmode=require.
# On IPv4-only networks, prefer the session pooler:
# postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Cloudflare R2 (S3-compatible). Endpoint is the account-specific S3 API URL,
# not the public bucket URL.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=glaiobjectbucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public CDN/base URL used in <img> and next/image. No trailing slash.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Session signing key for ambassador/admin auth (32+ random bytes, hex or base64).
AUTH_SECRET=

# Primary administrator. Sign in at /admin/login with this email and password.
# If the password here does not match the database, a successful staff sign-in
# updates the stored hash. Use 10+ characters. Keep this file private.
PRIMARY_ADMIN_NAME=GLAI Admin
PRIMARY_ADMIN_EMAIL=admin@example.org
PRIMARY_ADMIN_PASSWORD=

# Optional dedicated key for AES-256-GCM encryption of phone numbers. Falls back to AUTH_SECRET.
FIELD_ENCRYPTION_KEY=

# Transactional email (Resend). From-address must be a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GLAI <noreply@example.org>

# Mapbox public token for the Ambassador Network map (Stage 5).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Site URL used in emails, OG tags, and sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: payment processor keys (Stage 8). Leave empty to use the sandbox stub.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional WhatsApp OTP for membership sign-up (Meta Cloud API, preferred).
# If both Meta and Twilio are empty, local/dev confirm pages can show ?dev=CODE.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional Twilio WhatsApp fallback when Meta is not set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional analytics (Stage 11).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML tag verification token (Stage 11).
NEXT_PUBLIC_GSC_VERIFICATION=
